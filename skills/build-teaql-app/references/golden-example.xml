<?xml version="1.0" encoding="UTF-8"?>
<root name="pet-clinic-service"
      cfg_mask_china_mobile="false"
      data_service="sqlite"
      org="example"
      _module_key="root">
  <clinic _name="Clinic"
          _module="Organization"
          _module_key="organization"
          name="Harmony Pet Clinic"
          create_time="createTime()"
          update_time="updateTime()"/>

  <pet _name="Pet"
       _module="Clinical"
       _module_key="clinical"
       clinic="clinic()"
       name="Mochi"
       species="dog"
       birth_date="2020-05-10"
       microchipped="true"
       create_time="createTime()"
       update_time="updateTime()"/>

  <appointment_status _name="Appointment Status"
                      _module="Clinical"
                      _module_key="clinical"
                      clinic="clinic()"
                      id="id()"
                      name="string()"
                      code="string()"
                      color="string()"
                      display_order="number()"
                      progress="number()"
                      _constant="true"
                      _identifier="code">
    <_value id="1001" name="Pending" code="PENDING"
            color="#F59E0B" display_order="1" progress="0"/>
    <_value id="1002" name="Confirmed" code="CONFIRMED"
            color="#2563EB" display_order="2" progress="25"/>
    <_value id="1003" name="Completed" code="COMPLETED"
            color="#16A34A" display_order="3" progress="100"/>
    <_value id="1004" name="Cancelled" code="CANCELLED"
            color="#6B7280" display_order="4" progress="0"/>
  </appointment_status>

  <appointment _name="Appointment"
               _module="Clinical"
               _module_key="clinical"
               clinic="clinic()"
               pet="pet()"
               status="appointment_status()"
               appointment_time="2025-05-01T09:00:00"
               reason="Annual wellness exam"
               create_time="createTime()"
               update_time="updateTime()"/>
</root>
